# Generate independent random credentials; never use example values in production.
CALENDAR_API_KEY=
CALENDAR_FEED_TOKEN=
# Optional: independent 32–256 URL-safe characters; missing/invalid disables the widget.
DAKBOARD_WIDGET_KEY=
CALENDAR_NAME=Work Calendar
CALENDAR_DB_PATH=/var/data/calendar.db
CALENDAR_RSA_PRIVATE_KEY=
CALENDAR_RSA_KEY_ID=primary
CALENDAR_ALLOWED_ORIGINS=https://outlook.office.com,https://outlook.office365.com,https://outlook.cloud.microsoft
CALENDAR_MAX_PAYLOAD_BYTES=262144
CALENDAR_RETENTION_DAYS=90
CALENDAR_PRIVACY_MODE=full
# Browser build values (set CALENDAR_NAME=work-laptop in the browser build process)
API_BASE_URL=https://calendar-bridge.example.invalid
API_KEY=
